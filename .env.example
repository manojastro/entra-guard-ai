APP_ENV=development
DATABASE_PATH=entraguard.db

SERVICENOW_ENABLED=true
SERVICENOW_MODE=mock
SERVICENOW_AUTO_CREATE=false
SERVICENOW_AUTO_CREATE_MIN_SEVERITY=Critical
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_ASSIGNMENT_GROUP=Identity Security Team
SERVICENOW_ASSIGNMENT_GROUPS=Identity Security Team,SOC,IAM Operations,Cybersecurity Operations,Security Incident Response
SERVICENOW_DEFAULT_CATEGORY=Security
SERVICENOW_DEFAULT_SUBCATEGORY=Identity Security
SERVICENOW_PRIORITY_MAP={"Critical":{"impact":"1","urgency":"1"},"High":{"impact":"1","urgency":"2"},"Medium":{"impact":"2","urgency":"2"},"Low":{"impact":"2","urgency":"3"},"Informational":{"impact":"3","urgency":"3"}}
SERVICENOW_MAX_RETRIES=2
SERVICENOW_RATE_LIMIT_PER_MINUTE=10

